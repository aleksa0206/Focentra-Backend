PORT=4000

# Matches docker-compose.yaml. On Windows use 127.0.0.1, not localhost.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=focentra_app
DB_PASSWORD=focentra_app
DB_NAME=focentra
# Used only by the Prisma CLI (migrations)
DATABASE_URL="mysql://focentra_app:focentra_app@127.0.0.1:3307/focentra"

# At least 32 characters, e.g. `openssl rand -hex 32`
JWT_SECRET=

# CORS origin and the base of links in emails
FRONTEND_URL=http://localhost:4200

# Required only when NODE_ENV=production. MailHog on localhost:1025 works for development.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Focentra <noreply@focentra.local>"

# Enables GET /metrics for Prometheus (min 16 chars)
METRICS_TOKEN=
